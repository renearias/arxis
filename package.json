{
  "name": "arxis",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "build:api": "cd projects/arxis/api && npm version patch && ng build @arxis/api --configuration production",
    "deploy:api": "npm run build:api && npm run publish:api ",
    "test": "ng test @arxis/api",
    "test:ci": "ng test @arxis/api --watch=false --browsers=ChromeHeadless",
    "publish:api": "cd dist/arxis/api&&npm publish --access public"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^17.3.12",
    "@angular/compiler": "^17.3.12",
    "@angular/core": "^17.3.12",
    "@angular/platform-browser": "^17.3.12",
    "@angular/platform-browser-dynamic": "^17.3.12",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.14.3"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^17.3.17",
    "@angular/cli": "^17.3.17",
    "@angular/compiler-cli": "^17.3.12",
    "@types/jasmine": "~5.1.0",
    "jasmine-core": "~5.1.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "ng-packagr": "^17.3.0",
    "typescript": "~5.4.2"
  },
  "description": "Monorepo of @arxis/api, a type-safe Angular HTTP client wrapper.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/renearias/arxis.git"
  },
  "author": "Rene Arias",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/renearias/arxis/issues"
  },
  "homepage": "https://github.com/renearias/arxis#readme"
}
